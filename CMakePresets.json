{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2026",
      "displayName": "Windows x64 - Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/windows-vs2026",
      "architecture": "x64",
      "cacheVariables": {
        "SMART_DUCKING_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "macos-debug-arm64",
      "displayName": "macOS Debug (Apple Silicon)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos/debug-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SMART_DUCKING_BUILD_TESTS": "ON"
      },
      "environment": {
        "LDFLAGS": ""
      }
    },
    {
      "name": "macos-release-universal",
      "displayName": "macOS Release (Universal)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos/release-universal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SMART_DUCKING_BUILD_TESTS": "ON"
      },
      "environment": {
        "LDFLAGS": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-vs2026",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release"
    },
    {
      "name": "macos-debug-arm64",
      "configurePreset": "macos-debug-arm64"
    },
    {
      "name": "macos-release-universal",
      "configurePreset": "macos-release-universal"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-vs2026",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-debug-arm64",
      "configurePreset": "macos-debug-arm64",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-release-universal",
      "configurePreset": "macos-release-universal",
      "output": { "outputOnFailure": true }
    }
  ]
}
